generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── AUTH ────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  name           String?
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile        Profile?
  foods          Food[]
  foodLogs       FoodLog[]
  workouts       Workout[]
  bodyMetrics    BodyMetric[]
  habits         Habit[]
  habitLogs      HabitLog[]
  todos          Todo[]
  dailySummaries DailySummary[]
  integrations   Integration[]

  @@map("users")
}

// ─── PROFILE ─────────────────────────────────────────────────────────

model Profile {
  id             String  @id @default(cuid())
  userId         String  @unique
  height         Float?  // cm
  weight         Float?  // kg
  age            Int?
  sex            String? // male, female, other
  activityLevel  String? // sedentary, light, moderate, active, very_active
  goal           String? // lose, maintain, gain
  calorieTarget  Int?
  proteinTarget  Int?    // grams
  carbTarget     Int?    // grams
  fatTarget              Int?    // grams
  timezone               String  @default("UTC")
  cheatDay               String?  @default("Saturday")
  cheatDayDate           DateTime?
  cheatDayLastUsedMonth  String? // e.g. "2026-09"
  cheatDayLastUsedDate   DateTime?
  shieldsUsed            Int     @default(0)
  shieldsAvailable       Int     @default(1)
  totalShieldsEarned     Int     @default(1)
  lastMilestoneStreak    Int     @default(0)

  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─── NUTRITION ───────────────────────────────────────────────────────

model Food {
  id            String    @id @default(cuid())
  userId        String
  name          String
  brand         String?
  servingSize   Float     @default(100)
  servingUnit   String    @default("g")
  calories      Float     @default(0)
  protein       Float     @default(0)
  carbohydrates Float     @default(0)
  fat           Float     @default(0)
  fiber         Float     @default(0)
  isFavorite    Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodLogs      FoodLog[]

  @@index([userId, name])
  @@index([userId, isFavorite])
  @@map("foods")
}

model FoodLog {
  id            String   @id @default(cuid())
  userId        String
  foodId        String
  date          DateTime
  mealType      String   // breakfast, lunch, dinner, snack
  quantity      Float    @default(1)
  // Denormalized — server-computed at write time
  calories      Float    @default(0)
  protein       Float    @default(0)
  carbohydrates Float    @default(0)
  fat           Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  food          Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, date, mealType])
  @@map("food_logs")
}

// ─── WORKOUTS ────────────────────────────────────────────────────────

model Workout {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime
  workoutName   String
  duration      Int?     // minutes
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises     WorkoutExercise[]

  @@index([userId, date])
  @@map("workouts")
}

model Exercise {
  id           String  @id @default(cuid())
  name         String
  muscleGroup  String  // chest, back, shoulders, biceps, triceps, legs, core, cardio, full_body
  category     String  // compound, isolation, cardio, bodyweight, machine
  difficulty   String  @default("intermediate") // beginner, intermediate, advanced
  instructions String?
  isCustom     Boolean @default(false)
  externalId   String? // cached from external API

  workoutExercises WorkoutExercise[]

  @@unique([name, muscleGroup])
  @@index([muscleGroup])
  @@index([category])
  @@map("exercises")
}

model WorkoutExercise {
  id         String @id @default(cuid())
  workoutId  String
  exerciseId String
  order      Int    @default(0)

  workout    Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets       ExerciseSet[]

  @@index([workoutId])
  @@map("workout_exercises")
}

model ExerciseSet {
  id                String  @id @default(cuid())
  workoutExerciseId String
  setNumber         Int
  weight            Float?  // kg
  reps              Int?
  duration          Int?    // seconds (for timed exercises)
  distance          Float?  // meters (for cardio)
  rpe               Float?  // 1-10
  completed         Boolean @default(true)

  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
  @@map("exercise_sets")
}

// ─── BODY METRICS ────────────────────────────────────────────────────

model BodyMetric {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  weight    Float?   // kg
  bodyFat   Float?   // percentage
  waist     Float?   // cm
  chest     Float?   // cm
  arms      Float?   // cm
  thighs    Float?   // cm
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("body_metrics")
}

// ─── HABITS ──────────────────────────────────────────────────────────

model Habit {
  id               String    @id @default(cuid())
  userId           String
  name             String
  description      String?
  frequency        String    @default("daily") // daily, weekly, custom
  target           Int       @default(1)       // times per period
  color            String    @default("#10b981") // for UI
  icon             String?
  active           Boolean   @default(true)
  externalId       String?   // for Habitica sync
  externalProvider String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs             HabitLog[]

  @@index([userId, active])
  @@map("habits")
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      DateTime
  completed Boolean  @default(false)
  value     Float?   // optional numeric value
  notes     String?
  createdAt DateTime @default(now())

  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
  @@index([habitId, date])
  @@map("habit_logs")
}

// ─── TASKS ───────────────────────────────────────────────────────────

model Todo {
  id               String    @id @default(cuid())
  userId           String
  title            String
  description      String?
  dueDate          DateTime?
  priority         String    @default("normal") // normal, high, urgent
  status           String    @default("todo")   // todo, in_progress, done
  category         String?
  recurringPattern String?   // daily, weekdays, weekly, monthly, or null
  completedAt      DateTime?
  externalId       String?   // for Todoist sync
  externalProvider String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, externalId])
  @@map("todos")
}

// ─── ANALYTICS ───────────────────────────────────────────────────────

model DailySummary {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime
  calories          Float    @default(0)
  protein           Float    @default(0)
  carbohydrates     Float    @default(0)
  fat               Float    @default(0)
  workoutsCompleted Int      @default(0)
  habitsCompleted   Int      @default(0)
  habitsTotal       Int      @default(0)
  tasksCompleted    Int      @default(0)
  tasksTotal        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_summaries")
}

// ─── INTEGRATIONS ────────────────────────────────────────────────────

model Integration {
  id                String    @id @default(cuid())
  userId            String
  provider          String    // todoist, habitica, nutrition_api, exercise_api
  providerAccountId String?
  accessToken       String?   // encrypted
  refreshToken      String?   // encrypted
  metadata          String?   // JSON string for SQLite
  connectedAt       DateTime  @default(now())
  lastSyncedAt      DateTime?
  syncStatus        String    @default("idle") // idle, syncing, error, disconnected
  syncError         String?

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("integrations")
}
